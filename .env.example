# Copy to .env and fill in. `docker compose up --build` reads it.

# Required. Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Where you will open the app and where the browser reaches the API. Change both when you put Niyyah behind a domain,
# e.g. WEB_URL=https://niyyah.example.com and API_URL=https://niyyah-api.example.com (the web build bakes API_URL in).
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# "open" lets anyone create an account, "closed" turns registration off.
REGISTRATION=open

# Shown on the Terms and Privacy pages. Fill in for a public installation.
OPERATOR_NAME=
OPERATOR_CONTACT=

# Set to true only behind a reverse proxy you control that sets X-Forwarded-For (otherwise rate limits see the proxy as one client).
TRUST_FORWARDED_FOR=false

# Optional: Google Calendar (adding events from the Overview).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
